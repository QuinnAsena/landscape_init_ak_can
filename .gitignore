# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Ignore all contents of landscape directories except XML project files at their root
# and the scripts/ subdirectory (deployed iLand run scripts, e.g. saveWorkflow.js)
/landscape_*/**
!/landscape_*/*.xml
!/landscape_*/scripts/
!/landscape_*/scripts/**
/data/landscape_selection/
/data/lora_proj_temp/

# Claude Code internal files (worktrees, local session settings)
.claude/
iLandc_container/ilandc.sif
iLandc_container/ilandv2p1.sif

# Ignore temporary climate logs:
/logs/

# thread-scaling-test: iLand logs are 20-100 MB each and are reproducible by
# re-running the harness, so keep the analysis, not the raw logs. The parsed
# numbers live in results/*.csv and the figures in results/*.png, both committed.
# derecho_temp_log.txt is the exception -- it can only be regenerated by another
# Derecho run -- so results/derecho_log_excerpt.txt carries its essential lines.
thread-scaling-test/results/log_*.txt
thread-scaling-test/results/*.keep
thread-scaling-test/derecho_temp_log.txt
thread-scaling-test/results/*_console.txt
thread-scaling-test/report_files/
thread-scaling-test/report.html
